const USAGE = `interlock — deterministic decisions for the spec-driven flow

Usage:
  interlock waves --classified <file>       Plan execution waves from classified tasks
  interlock surface --changed <files...>    Classify UI testability of changed files
  interlock gate --findings <file>          Decide whether a review gate blocks
  interlock validate [change]               Inspect OpenSpec change artifacts
                                            (--change <name> is the same, as a flag)
  interlock changes                         List active OpenSpec changes
  interlock doctor                          Preflight the host before a run:
                                            Node, plugin install, PATH, the
                                            openspec CLI, git, the test profile,
                                            the permission allowlist, and the
                                            writability of the run-state dirs
  interlock drift [--changed <files>]        Report unarchived changes, broken spec
                                            references, aging specs, and orphan code
  interlock conformance [change]            List the spec scenarios a change must satisfy
  interlock limits                          Print every cap the loop obeys
  interlock evals triage --results <file>   Classify an eval results run:
                                            regression, variance, or no signal.
                                            No model, no network. Exit code is
                                            the verdict (1=regression,
                                            2=no signal, 3=configuration)
  interlock remediate --findings <file>     Plan one remediation round, or the verdict
  interlock review --findings <f> --verdicts <f>
                                           Resolve a review against skeptic verdicts
  interlock risk [change]                   Classify blast radius for the continuity gate
  interlock ledger [change]                 Summarize the decision ledger
  interlock ready [change] --findings <f>    Decide whether continuity may skip the human
  interlock outcomes append --record <f>    Append one run outcome to the corpus
  interlock outcomes list                   Read the outcome corpus back
  interlock run-log append --event <f>      Append one ship-run trajectory event
  interlock run-log list [--change <name>]  List recorded ship runs
  interlock run-log show <runId>            Print one run's events in order
  interlock run-log query --run <id>        Filter one run's events
  interlock run-log check --state <file>    Reconstructability gate: exit 1 on
                                            a gap, a missing start, or a
                                            missing run-halt/run-complete
  interlock tasks tick --ids <ids>          Tick succeeded task checkboxes by id
  interlock tasks coverage --classified <f> Halt if classified.json omits an unchecked task
  interlock verify plan --profile <file>    Decide which verification commands to run
  interlock verify judge --plan <f> --results <f>
                                           Judge reported results against the plan
  interlock verify unit --result <file>     Judge a unit result on its own
  interlock verify spill --run-id <id> --kind <k> --input <f>
                                           Spill oversized stdout/stderr to disk
  interlock verify cluster --failures <f>   Group failures by root-cause signature
  interlock verify repair --state <file>    Decide repair / halt / accept next
  interlock plan fingerprint [change]      Fingerprint a change's planning inputs
  interlock plan reuse [change]            Decide whether the stored plan may be
                                           reused, and narrow it if so
  interlock wave-state create --plan <file> Start a run state from a wave plan
  interlock wave-state next --state <file>  Ask what the run should do next
  interlock wave-state record-batch --state <f> --result <f>
  interlock wave-state record-verify --state <f> --result <f>
  interlock wave-state replan --state <f> --groups <f>
  interlock autonomy level <path>           Print the autonomy level of a path
  interlock autonomy record <path>          Record a run outcome
  interlock autonomy clean <paths...>       Credit a clean flow across paths
  interlock autonomy state                  Dump the full ladder

Common options:
  --json                 Emit JSON instead of human-readable text
  --root <dir>           Repo root (default: cwd)
  Any <file> argument accepts "-" to read that input from stdin. Only one input
  per invocation may be "-", since stdin can only be drained once.

Exit codes:
  Every gating command exits 1 when it blocks, so the workflow branches on exit
  status rather than on parsed prose:
    gate                     surviving findings block the gate
    doctor                   a preflight check would stop a zero-touch run
    validate                 the change is not ready
    remediate                blockers survive the verdict round
    verify judge             a halting kind failed in this context, a result
                             field exceeded the preview budget, or (with
                             --state/--run-id) the trajectory append failed
    verify unit              the unit suite is red or was weakened, or a
                             result field exceeded the preview budget
    verify repair            the root-cause repair budget is spent
    ledger                   the ledger is missing or unparseable, or
                             needs_human or invalid rows remain
    ready                    the change may not skip the human checkpoint
    tasks tick               an id could not be marked complete
    wave-state next          the run has halted, or the trajectory append failed
    wave-state record-*      the recorded result halted the run, or the
                             trajectory append failed
    run-log check            the run's trajectory is not reconstructable
    evals triage             at least one case is a regression (exit 1); a run
                             that yielded no signal (exit 2) or a configuration
                             problem (exit 3) is non-zero but distinct, so
                             neither reads as a clean pass
  risk never exits non-zero — branch on "continuityAllowed" instead, so a
  high-risk classification is a checkpoint rather than a failed command.

waves:
  --classified <file>    JSON: { "tasks": [{id, group, description, tier, model, isTestTask}] }
                         Use "-" to read from stdin.
  --max-parallel <n>     Cap agents spawned per batch (default ${LIMITS.maxParallel})

surface:
  --changed <files...>   Repo-relative paths. Use "-" to read newline-separated stdin.

gate:
  --findings <file>      JSON from the review dimensions. Use "-" for stdin.
  --dismissed <t1,t2>    Finding titles the skeptics verified away
  --min-quality <n>      Quality-band floor (default ${TOLERANCE_BAND.minQualityToReport})
  --no-tolerance         Report every surviving finding, however weak
  Findings the skeptics scored below the quality band are dropped before
  counting, so a weakly-grounded finding never blocks; unscored findings are
  always kept, and a skeptic disagreement wider than ${TOLERANCE_BAND.drift} keeps the finding.
  Exits 1 when the gate blocks, so callers can branch on exit status.

limits:
  Prints the caps the loop obeys and the workflow-runtime ceilings above them.
  Cite these rather than restating a number in prose.

doctor:
  The preflight. Every condition here would otherwise be discovered mid-run, by
  which point a zero-touch run has already spent waves of agents to learn it —
  or worse, has stopped on an approval prompt with nobody watching. Read-only:
  it names a fix for every failure and applies none of them.
  Checks: the Node version against the plugin floor and the OpenSpec CLI's
  higher one; the INSTALLED plugin's workflow, agent types and binaries
  (resolved from the plugin, never from the checkout you are standing in);
  interlock / interlock-graph on PATH; the openspec CLI and whether this project
  is initialised; git and a work tree; ${TEST_PROFILE_PATH};
  the permission allowlist; and whether the run-state directories can be
  written.
  The allowlist check derives the commands it requires — the four the flow
  always shells out to, plus whatever the test profile says this project runs —
  and reports an uncovered command as a FAILURE, since an approval prompt in an
  unattended run is a stopped run. A rule that exists but is narrower than the
  command it would have to permit (\`Bash(interlock waves:*)\` for a requirement
  of \`interlock\`) is reported as narrower, never counted as coverage. A "deny"
  that overlaps a required command fails; an "ask" warns; defaultMode
  "bypassPermissions" warns and checks nothing, because nothing will prompt.
  Exits 1 when any check fails. Warnings never gate.

remediate:
  --findings <file>      Review output, in any shape gate accepts. "-" for stdin.
  --round <n>            1-based (default 1). Rounds 1-${LIMITS.remediationRounds} are fix passes;
                         round ${LIMITS.remediationRounds + 1} is the verdict and is the only round that halts.
  --min-quality <n>      Quality-band floor, as for gate
  --no-tolerance         Disable the quality band
  Exits 1 when the plan halts (blockers survived the verdict round).

review:
  --findings <file>      Findings raised by the review dimensions. "-" for stdin.
  --verdicts <file>      Flat JSON array of skeptic verdicts. "-" for stdin.
  --metrics <change>     Also append the counts to .claude/metrics/ under this
                         change name. A metrics failure prints its reason and is
                         never fatal — the exit code is unaffected.
  --changed <p1,p2|->    The reviewed diff. A verdict that DISMISSES a finding
                         must cite "path:line" (or "path:start-end") naming a
                         path in this set — an uncited or unlocatable refutation
                         is a non-vote and the finding survives. Omit it and
                         only the citation shape is checked, never membership.
                         A verdict that a finding IS real needs no citation.
  --min-quality <n>      Quality-band floor, as for gate
  --no-tolerance         Disable the quality band
  Always exits 0; feed "surviving" to gate to decide whether it blocks.
  "dismissalsRejected" counts refutations refused for want of a citation — a
  high number means the skeptics are asserting rather than reading.

risk:
  [change]               OpenSpec change name (resolved like validate when omitted)
  --change <name>        Same, as a flag
  --paths <p1,p2>        Changed or planned repo-relative paths. "-" reads
                         newline-separated stdin.
  Artifact text is read from the change directory and classified alongside the
  paths. Fails closed: no usable signal classifies as high, never low.

ledger:
  [change]               OpenSpec change name (resolved like validate when omitted)
  Reads openspec/changes/<change>/decisions.md. Exits 1 when a needs_human row
  remains, when a row is invalid, or when the ledger is MISSING — an absent
  ledger is a failure of the audit, not an empty result, because an empty
  result reads as "nothing needs a human". The JSON distinguishes missing,
  unparseable, and present-and-empty.
  An agent_resolved row is audited: it needs a written resolution, evidence a
  reader can follow (a hedge such as "obvious" counts as blank), and its id must
  appear in the change's design.md. An absent or unreadable design.md makes
  every reference unresolvable rather than resolving all of them.

ready:
  [change]               OpenSpec change name (resolved like validate when omitted)
  --findings <file|->    The artifact review's own findings output. The blocker
                         count is DERIVED from it by the same evaluation
                         "interlock gate" uses. REQUIRED — absent, empty and
                         unparseable all mean the review did not run, never
                         zero blockers.
  --review <file|->      DEPRECATED: a transcribed { blockers, warnings } count.
                         Warns, and no longer satisfies the review-blockers
                         check on its own — the party writing that number is
                         the party being gated. When both are passed and they
                         disagree, --findings decides and the disagreement is
                         reported.
  --paths <p1,p2|->      Changed or planned repo-relative paths, for the risk class
  Fails closed: every check must affirmatively pass. A check that could not run
  is never a pass, and an error while gathering evidence becomes a blocker.
  Exits 1 when the change is not ready.

outcomes:
  append --record <f|->  One outcome object; see .claude/learning/README.md.
                         "mode" must be "checkpoint" or "continue" — an
                         unrecognised mode is refused rather than guessed.
                         The record supplies the "reported" half only. The
                         "observed" half is derived here from the run's
                         receipt, found via --state <f> or --run-id <id>; an
                         "observed" group in the record file is refused, and
                         so is an observed field smuggled into "reported".
                         No receipt means the record says so — it never falls
                         back to the values the record file carried.
  list                   Read .claude/learning/outcomes.jsonl back
  Nothing gates on this corpus yet; it is recorded so that it can, later.
  Always exits 0 — losing a corpus line must never fail the run that made it.

run-log:
  append --event <f|->   One trajectory event; type must be one of run-start,
                         wave-action, cli-exit, agent-spawn, verify-judgement,
                         run-halt, run-complete, run-receipt. Written to
                         .claude/ship/runs/<runId>.jsonl, seq assigned by the
                         writer. Never throws — an unwritable log is reported
                         on stderr, not raised.
                         run-receipt is what the run observed about itself —
                         wave tallies, plan fingerprint, review counts,
                         degradations, commit identifier — so a trajectory can
                         be read without the repository beside it. Its fields
                         are copied by name like every other type's, so a run
                         may hand it a whole summary object. Absent means
                         unobserved, never zero: a run that halted before its
                         review reports no review counts rather than none.
  list [--change <name>] List every run with a trajectory file: runId, change,
                         halted (with reason) or complete or in-progress, the
                         commit identifier, event/skipped counts, and whether a
                         receipt was recorded. Filter to one change with
                         --change. Tolerates a torn or garbage line the same
                         way "outcomes list" does — skips it, reports it.
  show <runId>           Print one run's events in sequence order.
  query --run <id> [--type <t>] [--halted]
                         Filter one run's events. --type keeps only that event
                         type. --halted keeps only the events that explain a
                         halt — the run-halt line, plus any verify-judgement
                         that itself halted — combine with --type to narrow
                         further.
  Session-query (list/show/query) is read-only and never-throws, like
  "outcomes list": a missing run, a torn final line, or an unreadable log is
  reported, never an exception. Always exits 0 — reading the trajectory is
  never itself a gate.
  check --state <file> | --run-id <id>
                         The reconstructability gate. Exits 1 unless the run's
                         trajectory has contiguous seq from 1, a run-start, a
                         run-halt or run-complete, and a cli-exit for every
                         wave-state / verify-judge invocation. A run-receipt is
                         not required — a run that died before its close could
                         not have written one — but two of them is a problem,
                         since a run has one close. Once this gate
                         is wired into "wave-state" and "verify judge" (see
                         those sections), a trajectory write failure on either
                         is itself a non-zero exit — the never-throw contract
                         above stays true only for "append"/"list"/"show"/
                         "query", not for the mutating commands the gate covers.

tasks:
  tick --ids <ids>       Comma-separated task ids (the leading token of a
                         checkbox, e.g. 1.1). Flips matching - [ ] to - [x].
                         Already-checked matches are reported, not rewritten.
                         Exits 1 and names every id it could not mark: a
                         completed task left silently unchecked reads
                         downstream as a failed task.
  coverage --classified <f>
                         Remaining unchecked checkboxes vs classified.json.
                         Exits 1 when an unchecked box has no matching id, so
                         ship cannot start implementers on a partial plan.
  [change] / --change    OpenSpec change name (resolved like validate)

verify plan:
  --profile <file>       Parsed .claude/testing/profile.json. "-" for stdin.
  --no-profile           Plan without a profile (reports hasProfile:false and a
                         skip reason rather than guessing a command)
  --typecheck-command <cmd>   Typecheck command; skipped when absent, never invented
  --lint-command <cmd>        Lint command; skipped when absent
  --e2e                  Opt in to e2e (off by default)
  --no-coverage          Skip coverage (advisory either way)
  --no-lint              Skip lint
  --pre-existing         The suite was already red before this change
  --elapsed-ms <n>       Verification time already spent this run
  --budget-ms <n>        Soft budget (default ${LIMITS.interWaveVerifyBudgetMs}ms); past it, typecheck only
  --context <ctx>        ${Object.keys(VERIFY_CONTEXTS).join('|')}. inter-wave omits e2e and
                         coverage by default (typecheck, unit, lint only).
  --changed <files...>   Repo-relative paths the last wave touched. When every
                         path is documentation, the plan emits no steps.

verify judge:
  --plan <file>          JSON from "interlock verify plan --json". "-" for stdin.
  --results <file>       JSON array of { kind, exitCode, ... } an agent reported
  --context <ctx>        ${Object.keys(VERIFY_CONTEXTS).join('|')} (default final). Load-bearing:
                         inter-wave halts on typecheck AND unit, final halts on
                         unit only, so a red typecheck stops the next wave but
                         does not stop the commit.
  --baseline <file>      Counts captured before the change, for the weakened-suite check
  --pre-existing         Excuse every failure as pre-existing
  --pre-existing-signatures <file>   JSON array of signatures known red beforehand
  --state <file>         Read "runId" from this wave-state file and append a
                         verify-judgement + cli-exit trajectory event pair
                         tagged with it. Omit --state and --run-id and no
                         event is logged; this command's exit code then never
                         depends on logging. Given either, a failed append now
                         ALSO exits 1 — the reconstructability gate (see
                         "run-log check") means a lost trajectory line here is
                         a halt, not a reported no-op.
  --run-id <id>          Same, when you have a run id but not a state file.
                         --state wins if both are given.
  --change <name>        Tag the logged event with this change name.
  Exits 1 when the verdict halts, or when --state/--run-id was given and the
  trajectory append failed.

verify unit / cluster / repair:
  --result <file>        verify unit: one unit result object. Exits 1 on halt.
  --failures <file>      verify cluster: JSON array of failure lines or objects
  --state <file>         verify repair: { iterationsUsed, clusters, halt, weakened,
                         preExisting, maxIterations }. Exits 1 when it halts.

verify judge / unit — the anti-swallow check:
  Before judging, every result's "detail", "cliStdout", "reason", "stdout",
  "stderr", "output", and each "failures[]" entry is checked against the
  verify preview budget (\`interlock limits\`). A field over budget is
  rejected outright — reason "oversized result field(s)" — rather than
  judged: a verify agent must spill it with \`interlock verify spill\` and
  pass the preview instead. Exits 1, same as any other halt.

verify spill:
  --run-id <id>          Run id the spilled output belongs to (required)
  --kind <k>             Step kind, e.g. unit/e2e/lint — becomes part of the
                         file name (required)
  --input <file|->       Raw combined stdout/stderr to spill (required)
  Writes the bytes to .claude/ship/spill/<runId>/<seq>-<kind>.log and prints
  { locator, bytes, preview, truncated, sha256 } — put locator + preview in the
  result the workflow's verify prompt writes, never the full text. Preview is a
  head/tail slice bounded by \`interlock limits\`' verify preview budget.
  Always exits 0.

plan:
  fingerprint [change]   Hash the inputs a plan for this change is derived from:
                         proposal.md, design.md, tasks.md (with checkbox markers
                         normalized, so ticking a task does not invalidate the
                         plan), every delta spec, the change name, --max-parallel,
                         the lane cap, and the plan format version. --write
                         stores it at ${FINGERPRINT_PATH}.
  reuse [change]         Compare a stored fingerprint against a fresh one and, on
                         a match, narrow the stored plan to incomplete tasks and
                         write it to --out (default ${NARROWED_PLAN_PATH}).
                         Reports "status" as one of match, inputs-changed,
                         no-plan, no-fingerprint, unreadable-plan,
                         unreadable-fingerprint, plan-format-changed,
                         check-failed — a named outcome, never a bare boolean.
                         "noRemainingWork" means every task in the plan is
                         already complete; do not create a run from it.
  --plan <file>          Stored plan to check (default ${PLAN_PATH})
  --fingerprint <file>   Stored fingerprint (default ${FINGERPRINT_PATH})
  --out <file>           Where "reuse" writes the narrowed plan
  --max-parallel <n>     The cap the plan was (or will be) built with; it is part
                         of the fingerprint, so asking for a different width
                         re-plans rather than reusing a differently-shaped plan.
  Never exits non-zero: every failure to establish a match — including an error
  raised while checking — is a reason to re-plan, which is what happens today.
  Branch on "reuse", and report "reason" either way.

wave-state:
  The run state machine, passed as JSON on stdin/stdout because the workflow
  script cannot hold state across agent calls — each agent reads the state in
  and writes the next one out.
  create --plan <file>              Plan from "interlock waves --json"; --max-parallel <n>
  next --state <file>               --json emits the STEP to take
  record-batch --state <f> --result <f>    result: { tasks: [{id, ok, error?, handoff?}], replanSuggested? }
                                           handoff: { schema: "interlock.wave-handoff/1", taskId,
                                           status: ok|blocked|partial, summary, evidence[], next,
                                           blocker }. A task claiming ok:true without a valid,
                                           in-budget packet is recorded as failed ("invalid
                                           handoff: ..."); see "interlock limits" for the cap.
                                           The next wave's step carries these as previousHandoffs.
  record-verify --state <f> --result <f>   result: { ok, errors?, blocksNextWave? } or
                                           { skipped: true, reason }
  replan --state <f> --groups <f>          groups: [{ group, tasks: [...] }]
  --write-state <file>   record-* / replan: write the new state to <file>;
                         with --json, stdout is the NEXT STEP (same shape as "next")
  --change <name>        Tag the trajectory events below with this change name
                         (default "unnamed"); has no effect on the state itself.
  With --json, create / record-* / replan emit the NEW STATE — pipe it into the
  next call. Only "next" emits a step instead. --write-state flips record-* /
  replan to that step-on-stdout shape so a ship agent need not call next again.
  Every subcommand also appends a wave-action + cli-exit event to
  .claude/ship/runs/<runId>.jsonl (runId read from the state). A failed append
  is reported on stderr AND now exits 1 (the reconstructability gate) — a lost
  trajectory line here is a halt, not a bookkeeping miss. "next" additionally
  logs one agent-spawn per task on a run-batch/test-wave step, same gate.

autonomy record:
  --blockers <n>         Blockers caught by this gate (default 0)
  --human-override       Record that a human overrode the result

Examples:
  interlock doctor || echo "fix these before starting a zero-touch run"
  interlock doctor --json | jq '.failures'
  interlock surface --changed src/Button.tsx docs/readme.md
  interlock waves --classified plan.json --max-parallel 6 --json
  interlock gate --findings review.json || echo "blocked"
  interlock limits --json
  interlock remediate --findings review.json --round 3 --json || echo "halted"
  interlock review --findings raised.json --verdicts verdicts.json --metrics add-auth
  interlock risk add-auth --paths src/auth/session.ts,src/api/login.ts --json
  interlock ledger add-auth || echo "a human still owes a decision"
  interlock verify plan --profile .claude/testing/profile.json --typecheck-command "npx tsc --noEmit" --json > vplan.json
  interlock verify judge --plan vplan.json --results results.json --context inter-wave || echo "halt"
  interlock plan reuse add-auth --json || true
  interlock plan fingerprint add-auth --write --json
  interlock waves --classified plan.json --json | interlock wave-state create --plan - --json > run.json
  interlock wave-state next --state run.json --json
  interlock wave-state record-batch --state run.json --result batch1.json --json > run2.json
  interlock wave-state record-batch --state run.json --result batch1.json --write-state run.json --json
  interlock autonomy level review-code
`

// Flags that never take a value. Everything else consumes the next argv entry
// unless that entry is itself a --flag.
const BOOLEAN_FLAGS = new Set([
  'json',
  'human-override',
  'no-tolerance',
  'e2e',
  'no-coverage',
  'no-lint',
  'no-profile',
  'pre-existing',
  'halted',
  'write'
])

function parseArgs(argv) {
  const out = { _: [], flags: {} }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (!a.startsWith('--')) {
      out._.push(a)
      continue
    }
    const key = a.slice(2)
    const next = argv[i + 1]
    // Boolean flags take no value.
    if (BOOLEAN_FLAGS.has(key)) {
      out.flags[key] = true
      continue
    }
    if (key === 'changed') {
      // Variadic: consume until the next --flag.
      const vals = []
      while (argv[i + 1] !== undefined && !argv[i + 1].startsWith('--')) vals.push(argv[++i])
      out.flags.changed = vals
      continue
    }
    if (next === undefined || next.startsWith('--')) {
      out.flags[key] = true
      continue
    }
    out.flags[key] = next
    i++
  }
  return out
}

// stdin can only be drained once, so a command asking for two "-" inputs would
// silently get an empty second one. Say so instead.
let stdinConsumed = false

function readStdin() {
  if (stdinConsumed) {
    die('only one input per invocation may be "-": stdin has already been read')
  }
  stdinConsumed = true
  try {
    return readFileSync(0, 'utf8')
  } catch {
    return ''
  }
}

function readInput(value, what) {
  if (!value || value === true) die(`${what} is required`)
  const raw = value === '-' ? readStdin() : readFileSync(value, 'utf8')
  try {
    return JSON.parse(raw)
  } catch (err) {
    die(`${what} is not valid JSON: ${err.message}`)
  }
}

// Like `readInput`, but for a payload that is bytes to spill rather than JSON
// to parse — `verify spill` hands this raw suite output, which is exactly the
// text the rest of the CLI must never try to JSON.parse.
function readRawInput(value, what) {
  if (!value || value === true) die(`${what} is required`)
  return value === '-' ? readStdin() : readFileSync(value, 'utf8')
}

function die(message) {
  process.stderr.write(`interlock: ${message}\n`)
  process.exit(1)
}

function warn(message) {
  process.stderr.write(`interlock: ${message}\n`)
}

function emit(json, obj, text) {
  process.stdout.write(json ? JSON.stringify(obj, null, 2) + '\n' : text)
}

/**
 * record-* / replan: default stdout is the new state. --write-state writes that
 * state to a file and stdout becomes nextStep() — the shape `wave-state next`
 * already emits — so a ship agent can record and learn the next action in one turn.
 */
function emitRecordedState(json, flags, state, { root, change, logOk = true, source, recorded } = {}) {
  const dest = flags['write-state']
  if (dest === true) die('--write-state requires a file path')
  if (dest === '-') die('--write-state cannot be "-"')
  // The per-task verdicts this call recorded, reported to the caller that
  // recorded them. Additive, on both paths: without it a host learns the next
  // action and never learns that a task it was told succeeded was failed on
  // arrival — so it ticks the box anyway. Never written to the state file: the
  // outcomes describe one batch, and a resumed run must not read them as its
  // own. (`mutable()` strips one that was piped back in.)
  const carry = obj => (recorded ? { ...obj, recorded } : obj)
  if (dest) {
    mkdirSync(dirname(dest), { recursive: true })
    writeFileSync(dest, JSON.stringify(state, null, 2) + '\n')
    const step = nextStep(state)
    const spawnOk = logAgentSpawns(root, { state, change, step, source })
    emit(json, carry(step), formatRunState(state))
    if (step.action === 'halt' || state.halt || !logOk || !spawnOk) process.exit(1)
    return
  }
  emit(json, carry(state), formatRunState(state))
  if (state.halt || !logOk) process.exit(1)
}

// `state.runId` travels on the frozen wave-state (design.md decision 1) — read
// the same defensive way `logWaveMutation` does, since a malformed state must
// not crash the CLI, only fail the (never-throw) trajectory append.
function runIdOf(state) {
  return state && typeof state.runId === 'string' ? state.runId : undefined
}

// `state.change` travels the same way `state.runId` does, and is read the same
// defensive way. It is the AUTHORITY over `--change` (design.md decision 2): the
// state's name was fixed when the run was created, while the flag is
// per-invocation and is the mechanism that demonstrably drifted. Preferring the
// flag would let one mislabeled call relabel part of a trajectory, producing a
// log whose lines disagree about which change they belong to — worse than a
// uniformly unnamed one, because it looks correct.
function changeOf(state) {
  const name = state && typeof state.change === 'string' ? state.change.trim() : ''
  return name || undefined
}

// The name to stamp on this invocation's events: the state's, else the flag's
// (a state.json written before the name was carried on state). Neither leaves it
// undefined, and `appendRunLogEvent` writes the absent-name placeholder rather
// than failing — losing a trajectory label must not lose the run.
function changeFor(state, flagChange) {
  const flag = typeof flagChange === 'string' && flagChange.trim() ? flagChange.trim() : undefined
  return changeOf(state) || flag
}

// `wave-state next` / `--write-state` both surface the state machine's next
// step. A `run-batch`/`test-wave` step carries `tasks[]` (the current batch, as
// LANES) and `remainingBatches` (rest of the wave, as batches of lanes). ship.js
// runs remainingBatches sequentially before the next record ping, so the
// reconstructable spawn list is remainingBatches — not only tasks[]. Mid-wave
// record-batch --write-state is cursor catch-up and MUST NOT duplicate those
// events.
//
// One spawn per LANE, because a lane is one agent. Counting per task would
// report four spawns for a wave that ran two, which is the fold this change
// exists for reported as if it never happened.
function spawnLanesOf(step) {
  const lanes =
    Array.isArray(step.remainingBatches) && step.remainingBatches.length
      ? step.remainingBatches.flat(1)
      : Array.isArray(step.tasks)
        ? step.tasks
        : []
  return lanes
    .map(lane => (Array.isArray(lane) ? lane.filter(t => t && typeof t === 'object') : []))
    .filter(lane => lane.length)
}

// The label the workflow gives the same agent (`workflows/ship.js` laneLabel), so
// a trajectory line and the agent it describes carry one name rather than two.
function laneLabelOf(lane) {
  return lane.length === 1 ? lane[0].id : `${lane[0].id}+${lane.length - 1}`
}

// The model the lane runs on: its hardest task's. A lane is one agent and that
// agent has to be capable of everything in it.
function laneModelOf(lane) {
  const tier = lane.reduce((m, t) => (Number.isInteger(t.tier) && t.tier > m ? t.tier : m), 0)
  const hardest = lane.find(t => t.tier === tier) || lane[0]
  return hardest && typeof hardest.model === 'string' ? hardest.model : undefined
}

// Takes the run's `state` rather than a runId, so the change name is resolved
// from it the same way `logWaveMutation` does instead of being threaded in by a
// caller who may not have been given one.
function logAgentSpawns(root, { state, change, step, source }) {
  if (!step || (step.action !== 'run-batch' && step.action !== 'test-wave')) return true
  if (source === 'record-batch' && Number(step.batchIndex) > 0) return true
  const runId = runIdOf(state)
  const changeName = changeFor(state, change)
  let ok = true
  for (const lane of spawnLanesOf(step)) {
    const spawn = appendRunLogEvent(root, {
      runId,
      change: changeName,
      type: 'agent-spawn',
      label: laneLabelOf(lane),
      model: laneModelOf(lane),
      kind: 'implementer',
      // The lane's anchor task. A multi-task lane's later ids are recoverable
      // from the plan and from its per-task record-batch results; what this line
      // is for is naming the AGENT, and there is one of those per lane.
      taskId: typeof lane[0].id === 'string' ? lane[0].id : undefined
    })
    if (!spawn.written) {
      process.stderr.write(`interlock: agent-spawn not recorded: ${spawn.reason}\n`)
      ok = false
    }
  }
  return ok
}

// The anti-swallow check (design.md §3.3): a verify agent that pasted a
// spilled suite log into a result field instead of using the locator+preview
// `interlock verify spill` handed it is rejected before its result reaches a
// judgement, never judged as if the oversized text were a legitimate report.
function rejectOversized(results, context) {
  const check = checkResultFieldSizes(results)
  if (check.ok) return null
  const reason =
    `oversized result field(s): ${check.violations
      .map(v => `${v.kind}.${v.field} (${v.length} chars, budget ${v.limit})`)
      .join(', ')} — spill it with \`interlock verify spill\` and pass the preview instead`
  return {
    halt: true,
    reason,
    context: context || null,
    haltingKinds: [],
    unit: null,
    e2e: null,
    coverage: null,
    signals: [{ level: 'halt', kind: 'oversized-result', message: reason }],
    banners: [reason],
    skipped: []
  }
}

// `verify judge` logs a trajectory event only when it can identify the run: a
// `--run-id` given directly, or one read from `--state`'s frozen `runId` field
// (design.md decision 4 — "the run id cannot drift" when it comes from the
// same state file the caller is already threading through the loop). Neither
// present means this judge call is not part of a logged ship run — e.g. a
// person running `interlock verify judge` by hand — so nothing is logged and
// nothing is required to be.
function stateFromFlags(flags) {
  const stateFile = flags.state
  if (typeof stateFile !== 'string' || stateFile === '-') return undefined
  try {
    return JSON.parse(readFileSync(stateFile, 'utf8'))
  } catch {
    // Unreadable or malformed state: no run identity to log against, and this
    // is not the command that should fail the run over a logging concern.
    return undefined
  }
}

function runIdFromFlags(flags) {
  if (typeof flags['run-id'] === 'string' && flags['run-id'].trim()) return flags['run-id'].trim()
  return runIdOf(stateFromFlags(flags))
}

// The mark `durationMs` on a `cli-exit` is measured from. Taken at module scope
// so it covers everything this process does under its own name — flag parsing
// and the lib/ call — rather than only the last few statements before the
// append.
//
// It is CLI SELF-TIME and nothing else. This process runs BETWEEN agent turns
// and never observes one, so the interval here is typically a millisecond or
// two; `lib/run-log.mjs` states the same limit at the field, and wave elapsed
// time comes from `deriveWaveElapsed` instead. Filling the field with a number
// that looked like agent wall clock would be worse than leaving it null.
const CLI_STARTED_AT = performance.now()

// `undefined` rather than `0` when the clock gives nothing usable: the writer
// coerces an absent value to `null`, and `null` reads as "not measured" while a
// `0` would assert an instantaneous command.
function cliDurationMs() {
  const ms = performance.now() - CLI_STARTED_AT
  return Number.isFinite(ms) && ms >= 0 ? Math.round(ms) : undefined
}

// A `verify-judgement` line never carries the suite transcript: only the
// verdict's own short reason and status, plus locators for whatever the
// verify helper already spilled (task 3.3) — never the results' raw text.
// Returns whether the trajectory was written, so the reconstructability gate
// (task 6.2) can turn a failed append into a non-zero exit once it is wired
// in — a caller with no runId gets `true` back, since nothing was owed.
function logVerifyJudgement(root, { runId, change, verdict, results }) {
  if (!runId) return true
  const spill = Array.isArray(results)
    ? results.filter(r => r && typeof r.locator === 'string' && r.locator).map(r => r.locator)
    : []
  const logged = appendRunLogEvent(root, {
    runId,
    change,
    type: 'verify-judgement',
    context: verdict.context,
    halt: verdict.halt,
    reason: verdict.reason || (verdict.halt ? 'verification halted' : 'verification ok'),
    unitStatus: verdict.unit ? verdict.unit.status : null,
    spill
  })
  if (!logged.written) {
    process.stderr.write(`interlock: verify-judgement not recorded: ${logged.reason}\n`)
  }
  // Mirrors what `logWaveMutation` does for `wave-state`: a `cli-exit` alongside
  // the semantic event, so the reconstructability check (task 6.1) can require
  // "a cli-exit per wave-state / verify judge invocation" uniformly, without
  // special-casing verify.
  const exit = appendRunLogEvent(root, {
    runId,
    change,
    type: 'cli-exit',
    command: 'verify judge',
    exitCode: verdict.halt ? 1 : 0,
    durationMs: cliDurationMs()
  })
  if (!exit.written) {
    process.stderr.write(`interlock: cli-exit not recorded: ${exit.reason}\n`)
  }
  return logged.written && exit.written
}

// `wave-state create|next|record-*|replan` all append their own trajectory
// events (design.md decision 1: `runId` is created once, in createRunState,
// and travels on the frozen state — no new flag needed) so a ship agent never
// spends a turn calling `run-log append` itself for a wave-state mutation.
// `nextStep(state)` already knows the state-machine action, wave, and cursor
// this event describes; callers that also need `step` for their own stdout
// (e.g. `next`) get it back instead of computing it twice. `ok` reports
// whether both appends were written, so the reconstructability gate (task
// 6.2) can turn a failed trajectory write into a non-zero exit.
function logWaveMutation(root, { source, change, state }) {
  const step = nextStep(state)
  const runId = runIdOf(state)
  const changeName = changeFor(state, change)
  const wave = appendRunLogEvent(root, {
    runId,
    change: changeName,
    type: 'wave-action',
    source,
    action: step.action,
    // `step.wave` is `wave.group` from lib/waves.mjs — a plan-assigned integer,
    // not a label — so it is stringified for the text field rather than dropped.
    wave: step.wave === undefined || step.wave === null ? null : String(step.wave),
    waveIndex: Number.isInteger(step.waveIndex) ? step.waveIndex : null,
    batchIndex: Number.isInteger(step.batchIndex) ? step.batchIndex : null,
    phase: state && state.cursor ? state.cursor.phase : null
  })
  if (!wave.written) {
    process.stderr.write(`interlock: wave-action not recorded: ${wave.reason}\n`)
  }
  const exit = appendRunLogEvent(root, {
    runId,
    change: changeName,
    type: 'cli-exit',
    command: `wave-state ${source}`,
    // `nextStep` returns action:'halt' exactly when state.halt is set, so this
    // mirrors the exit code every call site below actually produces.
    exitCode: state && state.halt ? 1 : 0,
    durationMs: cliDurationMs()
  })
  if (!exit.written) {
    process.stderr.write(`interlock: cli-exit not recorded: ${exit.reason}\n`)
  }
  return { step, ok: wave.written && exit.written }
}

/**
 * The changed-path set as VERSION CONTROL sees it, for auditing handoff
 * evidence at `record-batch`.
 *
 * Read here rather than in `lib/waves.mjs` because that module is pure, and
 * read at THIS moment because it is the only one that means anything: the
 * working tree still matches what the implementer just claimed. Audited later,
 * the tree has moved and a `confirmed` verdict is worthless.
 *
 * Never throws, following `lib/drift.mjs`'s `gitLastCommit` precedent. Missing
 * git, a non-repository directory, a worktree in a state git dislikes — all
 * mean "no observed set", which is a documented fallback to the task's own
 * report, never a failed batch. Recording a wave's work must not depend on git
 * being cooperative.
 *
 * `-z` because a path with a space, a quote or a tab is a path, not a parse
 * error; `--untracked-files=all` because a new file inside a new directory
 * would otherwise be reported as the directory and match no locator.
 */
function observedChangedPaths(root) {
  let raw
  try {
    raw = execFileSync('git', ['status', '--porcelain', '-z', '--untracked-files=all'], {
      cwd: root,
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore']
    })
  } catch {
    return []
  }

  const fields = raw.split('\0').filter(f => f.length)
  const paths = []
  for (let i = 0; i < fields.length; i++) {
    const field = fields[i]
    // "XY path". Anything shorter carries no path.
    if (field.length < 4) continue
    const status = field.slice(0, 2)
    const path = field.slice(3)
    if (path) paths.push(path)
    // A rename or copy carries its SOURCE in the following field. Both sides are
    // paths this run changed, so both are kept — and the source has to be
    // consumed here or the next iteration would read it as a status line and
    // slice three characters off the front of a real path.
    if (/[RC]/.test(status) && fields[i + 1]) {
      paths.push(fields[i + 1])
      i += 1
    }
  }
  return paths
}

// --min-quality / --no-tolerance mean the same thing everywhere the tolerance
// band applies, so the three call sites share one reading of them.
function parseBand(flags) {
  if (flags['no-tolerance']) return null
  if (flags['min-quality'] === undefined) return undefined
  const min = flags['min-quality'] === true ? NaN : Number(flags['min-quality'])
  if (!Number.isFinite(min)) die('--min-quality requires a number')
  return { ...TOLERANCE_BAND, minQualityToReport: min }
}

function num(flags, key) {
  if (flags[key] === undefined) return undefined
  const n = flags[key] === true ? NaN : Number(flags[key])
  if (!Number.isFinite(n)) die(`--${key} requires a number`)
  return n
}

function requestedName(positional, flags) {
  if (typeof flags.change === 'string' && flags.change.trim()) return flags.change.trim()
  return positional[1]
}

// One resolution path for every command that names a change, so "which change?"
// fails the same actionable way each time.
function requireChange(root, requested, json) {
  const resolved = resolveChange(root, requested)
  if (!resolved.error) return resolved.name
  if (json) {
    emit(true, resolved, '')
    process.exit(1)
  }
  die(
    `${resolved.error}${
      resolved.candidates.length ? `\n  candidates: ${resolved.candidates.join(', ')}` : ''
    }`
  )
}

// risk.mjs is pure and takes artifact TEXT, so the filesystem read belongs here.
function readChangeArtifacts(root, change) {
  const info = inspectChange(root, change)
  const artifacts = {}
  for (const name of info.present) {
    artifacts[name] = readFileSync(join(info.path, name), 'utf8')
  }
  for (const rel of info.specFiles) {
    const p = join(info.path, 'specs', rel)
    if (existsSync(p)) artifacts[join('specs', rel)] = readFileSync(p, 'utf8')
  }
  return artifacts
}

function splitPaths(value) {
  if (value === undefined || value === true) return []
  const raw = value === '-' ? readStdin().split('\n') : String(value).split(',')
  return raw.map(p => p.trim()).filter(Boolean)
}

function main() {
  const argv = process.argv.slice(2)
  if (!argv.length || argv[0] === '-h' || argv[0] === '--help') {
    process.stdout.write(USAGE)
    return
  }

  const { _: positional, flags } = parseArgs(argv)
  const cmd = positional[0]
  const json = Boolean(flags.json)
  const root = typeof flags.root === 'string' ? flags.root : '.'

  switch (cmd) {
    case 'waves': {
      const input = readInput(flags.classified, '--classified')
      const maxParallel = flags['max-parallel'] ? Number(flags['max-parallel']) : undefined
      const plan = planWaves(input, { maxParallel })
      emit(json, plan, formatPlan(plan))
      break
    }

    case 'surface': {
      let changed = flags.changed
      if (changed === '-' || (Array.isArray(changed) && changed[0] === '-')) {
        changed = readStdin().split('\n')
      }
      if (!Array.isArray(changed)) changed = changed ? [changed] : []
      const result = classifySurface(changed)
      const text =
        result.files.map(f => `${f.class}\t${f.path}\t(${f.reason})`).join('\n') +
        (result.files.length ? '\n' : '') +
        `\nui=${result.uiCount} indirect=${result.indirectCount} backend=${result.backendCount}\n` +
        `needsManualTestPlan=${result.needsManualTestPlan} needsDevopsReview=${result.needsDevopsReview}\n`
      emit(json, result, text)
      break
    }

    case 'gate': {
      const input = readInput(flags.findings, '--findings')
      const dismissed =
        typeof flags.dismissed === 'string'
          ? flags.dismissed.split(',').map(s => s.trim()).filter(Boolean)
          : []
      // The band is on by default and applied inside evaluateGate; these flags
      // only tune or disable it.
      const band = parseBand(flags)
      const result = evaluateGate(input, { dismissed, band })
      emit(json, result, formatGate(result))
      if (!result.passed) process.exit(1)
      break
    }

    case 'validate': {
      const name = requireChange(root, requestedName(positional, flags), json)
      const result = inspectChange(root, name)
      emit(json, result, formatInspection(result))
      if (!result.ready) process.exit(1)
      break
    }

    case 'changes': {
      const changes = listChanges(root)
      emit(json, { changes }, changes.length ? changes.join('\n') + '\n' : '(none)\n')
      break
    }

    case 'drift': {
      // No exit(1) here, ever. Unlike every other gating subcommand, drift
      // reports and does not block — see the header of lib/drift.mjs for why.
      //
      // `--changed` absent and `--changed` empty are different: absent means the
      // caller has no diff and orphan detection cannot run, empty means the diff
      // was genuinely empty. Only the first is "not checked".
      const changed = flags.changed === undefined ? null : splitPaths(flags.changed)
      const report = analyzeDrift(root, changed ? { changed } : {})
      emit(json, report, formatDrift(report) + '\n')
      break
    }

    case 'conformance': {
      // Emits questions, never verdicts, and never exits non-zero — see the
      // header of lib/conformance.mjs.
      const name = typeof flags.change === 'string' ? flags.change : positional[1]
      const changed = flags.changed === undefined ? [] : splitPaths(flags.changed)
      const result = buildChecklist(root, name, { changed })
      emit(json, result, formatChecklist(result) + '\n')
      break
    }

    case 'limits': {
      emit(json, { limits: LIMITS, runtime: RUNTIME, evals: EVAL_CAPS }, formatLimits())
      break
    }

    case 'doctor': {
      // Read-only by construction — see the header of lib/doctor.mjs. The exit
      // code is the whole point: a preflight that only prints is a preflight a
      // zero-touch run walks straight past.
      const report = diagnose(root)
      emit(json, report, formatDoctor(report))
      if (!report.ok) process.exit(1)
      break
    }

    case 'evals': {
      const sub = positional[1]
      if (sub === 'triage') {
        const results = readInput(flags.results, '--results')
        const verdict = triage(results)
        emit(json, verdict, formatTriage(verdict))
        if (verdict.exitCode) process.exit(verdict.exitCode)
      } else {
        die(`unknown evals subcommand: ${sub || '(none)'} — expected triage`)
      }
      break
    }

    case 'remediate': {
      const input = readInput(flags.findings, '--findings')
      const round = num(flags, 'round')
      const plan = planRemediation(input, { round, band: parseBand(flags) })
      emit(json, plan, formatRemediationPlan(plan))
      if (plan.halt) process.exit(1)
      break
    }

    case 'review': {
      const findings = readInput(flags.findings, '--findings')
      const verdicts = readInput(flags.verdicts, '--verdicts')
      // The reviewed diff. A dismissing verdict has to cite a path that is in
      // it — shape alone is satisfied by inventing `lib/nowhere.ts:1`. Optional
      // because a caller that cannot name the changed files must still get the
      // shape half rather than no gate at all.
      const changedPaths = splitPaths(flags.changed)
      const result = resolveReview(findings, verdicts, {
        band: parseBand(flags),
        changedPaths
      })

      // Metrics are bookkeeping: they report their own failure and never touch
      // the exit code, so a read-only checkout cannot fail a review.
      let metrics = null
      if (flags.metrics !== undefined) {
        if (flags.metrics === true) die('--metrics requires a change name')
        metrics = writeReviewMetrics(root, { change: String(flags.metrics), counts: result.counts })
        if (!metrics.written) warn(`metrics not written: ${metrics.reason}`)
      }

      const text =
        formatReview(result) +
        (metrics ? `  metrics: ${metrics.written ? metrics.path : `not written (${metrics.reason})`}\n` : '')
      emit(json, metrics ? { ...result, metrics } : result, text)
      break
    }

    case 'risk': {
      const requested = typeof flags.change === 'string' ? flags.change : positional[1]
      const changedPaths = splitPaths(flags.paths)

      let change = null
      let artifacts = {}
      const resolved = resolveChange(root, requested)
      if (resolved.error) {
        // Paths alone are still an honest basis; without them there is nothing
        // to classify, so the unresolved change is the error.
        if (!changedPaths.length) {
          requireChange(root, requested, json)
        }
        warn(`${resolved.error} — classifying from --paths alone, with no artifact text`)
      } else {
        change = resolved.name
        artifacts = readChangeArtifacts(root, change)
      }

      const result = classifyRisk({ changedPaths, artifacts })
      emit(json, { change, ...result }, formatRisk(result))
      break
    }

    case 'ledger': {
      const name = requireChange(root, requestedName(positional, flags), json)
      const parsed = readLedger(root, name)
      const summary = summarizeLedger(parsed)
      // `summary.invalid` is a count, so the rows behind it get their own key
      // rather than shadowing it.
      emit(
        json,
        { change: name, path: parsed.path, ...summary, rows: parsed.rows, invalidRows: parsed.invalid },
        formatLedger(parsed)
      )
      // A missing ledger exits non-zero and says *missing*, not *empty*. The
      // audit's likeliest failure is that it was never written, and an empty
      // result reads as "nothing needs a human" — which is the one conclusion
      // an absent file cannot support. `summary.missing` / `summary.unparseable`
      // keep the three cases distinguishable in the JSON.
      if (summary.blocking) process.exit(1)
      break
    }

    case 'ready': {
      const name = requireChange(root, requestedName(positional, flags), json)
      // Read RAW, not parsed: an unreadable findings file must reach the gate
      // as "the review did not run" and become a blocker with a reason, rather
      // than dying in the argument parser with a message nobody records.
      const findings = flags.findings ? readRawInput(flags.findings, '--findings') : undefined
      const review = flags.review ? readInput(flags.review, '--review') : undefined
      if (review !== undefined && findings === undefined) {
        warn(
          '--review is deprecated and no longer satisfies the review-blockers check on its own: ' +
            'its provenance is the agent being gated. Pass the artifact review\'s own findings ' +
            'file to --findings instead.'
        )
      }
      const paths =
        typeof flags.paths === 'string'
          ? (flags.paths === '-' ? readStdin() : flags.paths)
              .split(flags.paths === '-' ? '\n' : ',')
              .map(s => s.trim())
              .filter(Boolean)
          : undefined
      const result = assessReadiness(root, name, { findings, review, changedPaths: paths })
      emit(json, result, formatReadiness(result))
      // Fail closed: not-ready is a non-zero exit, so a caller that forgets to
      // read the JSON still cannot walk past the gate.
      if (!result.ready) process.exit(1)
      break
    }

    case 'outcomes': {
      const sub = positional[1]
      if (sub === 'append') {
        const record = readInput(flags.record, '--record <file|->')
        // The record file is composed by an agent on the workflow host, so the
        // observed half is never taken from it: it is derived here from the
        // run's own receipt. A record file that carries one is refused by name
        // rather than passed through — the prompt is documentation and the
        // writer is the mechanism.
        const supplied =
          record && typeof record === 'object' && !Array.isArray(record) ? record : {}
        const carriedObserved = Object.prototype.hasOwnProperty.call(supplied, 'observed')
        const { observed: _refused, ...reportedHalf } = supplied
        const runId = runIdFromFlags(flags)
        // No run identity, or no receipt on the trajectory, records the
        // absence. It deliberately does not fall back to the record file:
        // trusting the untrusted source exactly when the trusted one is
        // missing would defeat the partition on the runs most likely to need
        // it.
        const receipt = runId
          ? queryRunLog(root, runId, { type: 'run-receipt' }).records.pop() || null
          : null
        const written = appendOutcome(root, { ...reportedHalf, observed: observedFromReceipt(receipt) })
        if (carriedObserved) {
          warn(
            'outcome record carried an "observed" group: refused. Observed values are derived ' +
              'from the run receipt, never supplied by the step that writes the record.'
          )
        }
        if (!written.written) {
          // Never fatal: losing a corpus line must not fail the run that
          // produced it. Say so on stderr and exit 0.
          process.stderr.write(`interlock: outcome not recorded: ${written.reason}\n`)
        } else if (written.reason) {
          // Written, but partly refused. Reported for the same reason: a
          // closing step whose payload was refused should be able to say so.
          warn(`outcome recorded with a refusal: ${written.reason}`)
        }
        emit(
          json,
          { ...written, observedRefused: carriedObserved, receipt: Boolean(receipt) },
          `${written.written ? `recorded → ${written.path}` : `not recorded: ${written.reason}`}\n`
        )
      } else if (sub === 'list' || sub === undefined) {
        const result = readOutcomes(root)
        emit(json, result, formatOutcomes(result))
      } else {
        die(`unknown outcomes subcommand: ${sub}`)
      }
      break
    }

    case 'run-log': {
      const sub = positional[1]
      if (sub === 'append') {
        const record = readInput(flags.event, '--event <file|->')
        const { written, path, reason } = appendRunLogEvent(root, record)
        if (!written) {
          // Never fatal: losing a trajectory line must not fail the run that
          // produced it. Say so on stderr and exit 0.
          process.stderr.write(`interlock: event not recorded: ${reason}\n`)
        }
        emit(json, { written, path, reason }, `${written ? `recorded → ${path}` : `not recorded: ${reason}`}\n`)
      } else if (sub === 'list') {
        const change = typeof flags.change === 'string' ? flags.change : undefined
        const runs = listRunLogs(root, { change })
        emit(json, { runs }, formatRunLogList(runs))
      } else if (sub === 'show') {
        const runId = positional[2]
        if (!runId) die('run-log show requires a runId')
        const result = readRunLog(root, runId)
        emit(json, result, formatRunLog(result))
      } else if (sub === 'query') {
        const runId = typeof flags.run === 'string' ? flags.run : undefined
        if (!runId) die('--run is required')
        const result = queryRunLog(root, runId, {
          type: typeof flags.type === 'string' ? flags.type : undefined,
          halted: flags.halted === true
        })
        emit(json, result, formatRunLog(result))
      } else if (sub === 'check') {
        const runId = runIdFromFlags(flags)
        if (!runId) die('run-log check requires --state <file> (with a runId) or --run-id <id>')
        const result = checkRunLog(root, runId)
        emit(json, result, formatRunLogCheck(result))
        if (!result.ok) process.exit(1)
      } else {
        die(`unknown run-log subcommand: ${sub || '(none)'} — expected append|list|show|query|check`)
      }
      break
    }

    case 'tasks': {
      const sub = positional[1]
      if (sub === 'tick') {
        const name = requireChange(root, requestedName(positional, flags), json)
        const ids = splitPaths(flags.ids)
        if (!ids.length) die('--ids is required')
        const result = tickTasks(root, name, ids)
        const text =
          `ticked ${result.ticked.length}` +
          (result.already.length ? `, already ${result.already.length}` : '') +
          (result.missing.length ? `, missing ${result.missing.join(', ')}` : '') +
          `\n`
        emit(json, result, text)
        // An id that could not be marked exits non-zero and names itself. A
        // completed task left silently unchecked reads downstream as a failed
        // task, so the caller has to be able to see the difference — and an
        // empty id set is refused above, which keeps "nothing to mark" distinct
        // from "marking failed".
        if (result.missing.length) {
          process.stderr.write(
            `interlock: could not mark ${result.missing.length} task id(s) complete in ` +
              `${result.path}: ${result.missing.join(', ')} — no matching checkbox\n`
          )
          process.exit(1)
        }
      } else if (sub === 'coverage') {
        const name = requireChange(root, requestedName(positional, flags), json)
        const classified = readInput(flags.classified, '--classified')
        const inspection = inspectChange(root, name)
        const listed = Array.isArray(classified)
          ? classified
          : Array.isArray(classified.tasks)
            ? classified.tasks
            : []
        const result = { change: name, ...planCoverage(inspection.tasks.items, listed) }
        const text = result.ok
          ? `COVERAGE OK — ${result.classified} classified, ${result.remaining} remaining\n`
          : `COVERAGE GAP — omitted: ${result.omitted.join(', ')}\n`
        emit(json, result, text)
        if (!result.ok) process.exit(1)
      } else {
        die(`unknown tasks subcommand: ${sub || '(none)'} — expected tick|coverage`)
      }
      break
    }

    case 'verify': {
      const sub = positional[1]
      if (sub === 'plan') {
        const profile = flags['no-profile']
          ? null
          : readInput(flags.profile, '--profile <file|-> (or --no-profile)')
        const opts = {
          e2e: flags.e2e === true,
          coverage: flags['no-coverage'] !== true,
          lint: flags['no-lint'] !== true,
          typecheckCommand:
            typeof flags['typecheck-command'] === 'string' ? flags['typecheck-command'] : null,
          lintCommand: typeof flags['lint-command'] === 'string' ? flags['lint-command'] : null,
          preExistingFailures: flags['pre-existing'] === true
        }
        const elapsedMs = num(flags, 'elapsed-ms')
        if (elapsedMs !== undefined) opts.elapsedMs = elapsedMs
        const budgetMs = num(flags, 'budget-ms')
        if (budgetMs !== undefined) opts.budgetMs = budgetMs
        const context = flags.context === undefined ? undefined : String(flags.context)
        if (context !== undefined) {
          if (!Object.prototype.hasOwnProperty.call(VERIFY_CONTEXTS, context)) {
            die(
              `--context must be one of ${Object.keys(VERIFY_CONTEXTS).join('|')} (got "${context}")`
            )
          }
          opts.context = context
          if (context === 'inter-wave') opts.coverage = false
        }
        if (flags.changed !== undefined) {
          opts.changed = Array.isArray(flags.changed) ? flags.changed : splitPaths(flags.changed)
        }

        const plan = planVerification(profile, opts)
        emit(json, plan, formatVerification(plan))
      } else if (sub === 'judge') {
        const plan = readInput(flags.plan, '--plan <file|->')
        if (!plan || !Array.isArray(plan.steps) || !Array.isArray(plan.skipped)) {
          die('--plan must be the JSON output of `interlock verify plan --json`')
        }
        const results = readInput(flags.results, '--results <file|->')
        if (!Array.isArray(results)) {
          die('--results must be a JSON array of { kind, exitCode, ... } objects')
        }
        const context = flags.context === undefined ? 'final' : String(flags.context)
        if (!Object.prototype.hasOwnProperty.call(VERIFY_CONTEXTS, context)) {
          die(
            `--context must be one of ${Object.keys(VERIFY_CONTEXTS).join('|')} (got "${context}")`
          )
        }
        const rejection = rejectOversized(results, context)
        if (rejection) {
          emit(json, rejection, formatVerification(rejection))
          process.exit(1)
        }
        const opts = { context, ...verifyJudgeOpts(flags) }
        const verdict = judgeVerification(plan, results, opts)
        const logOk = logVerifyJudgement(root, {
          runId: runIdFromFlags(flags),
          // Same precedence as every wave-state append site: the state names the
          // run, the flag is only the pre-state-name fallback.
          change: changeFor(stateFromFlags(flags), flags.change),
          verdict,
          results
        })
        emit(json, verdict, formatVerification(verdict))
        if (verdict.halt || !logOk) process.exit(1)
      } else if (sub === 'unit') {
        const result = readInput(flags.result, '--result <file|->')
        const rejection = rejectOversized([result])
        if (rejection) {
          emit(json, rejection, formatVerification(rejection))
          process.exit(1)
        }
        const judgement = judgeUnitResult(result, verifyJudgeOpts(flags))
        emit(json, judgement, formatVerification(judgement))
        if (judgement.halt) process.exit(1)
      } else if (sub === 'spill') {
        const runId = typeof flags['run-id'] === 'string' ? flags['run-id'].trim() : ''
        if (!runId) die('--run-id is required')
        const kind = typeof flags.kind === 'string' ? flags.kind.trim() : ''
        if (!kind) die('--kind is required')
        const raw = readRawInput(flags.input, '--input <file|->')
        const result = spillBytes(root, { runId, kind, bytes: raw })
        emit(
          json,
          result,
          `spilled ${result.bytes} byte(s) → ${result.locator}${result.truncated ? ' (truncated preview)' : ''}\n`
        )
      } else if (sub === 'cluster') {
        const failures = readInput(flags.failures, '--failures <file|->')
        if (!Array.isArray(failures)) {
          die('--failures must be a JSON array of failure lines or objects')
        }
        const clusters = clusterFailures(failures)
        const text = clusters.length
          ? clusters.map(c => `  x${c.count}\t${c.signature}`).join('\n') + '\n'
          : 'no failures\n'
        emit(json, clusters, text)
      } else if (sub === 'repair') {
        const state = readInput(flags.state, '--state <file|->')
        const action = nextRepairAction(state)
        emit(json, action, formatVerification(action))
        if (action.action === 'halt') process.exit(1)
      } else {
        die(
          `unknown verify subcommand: ${sub || '(none)'} — expected plan|judge|unit|spill|cluster|repair`
        )
      }
      break
    }

    case 'plan': {
      const sub = positional[1]
      // `requestedName` reads positional[1], which here is the SUBCOMMAND — so
      // the change is positional[2] or --change, and a bare `interlock plan
      // reuse` resolves the single active change the same way validate does.
      const requested =
        typeof flags.change === 'string' && flags.change.trim() ? flags.change.trim() : positional[2]
      const maxParallel = num(flags, 'max-parallel')

      if (sub === 'fingerprint') {
        const name = requireChange(root, requested, json)
        const fp = computeFingerprint(root, name, { maxParallel })
        let written = null
        if (flags.write === true) {
          const dest = typeof flags.fingerprint === 'string' ? flags.fingerprint : undefined
          written = writeFingerprint(root, fp, { path: dest })
          if (!written.written) warn(`fingerprint not written: ${written.reason}`)
        }
        const text =
          formatFingerprint(fp) +
          (written
            ? `  ${written.written ? `written → ${written.path}` : `not written (${written.reason})`}\n`
            : '')
        emit(json, written ? { ...fp, written } : fp, text)
        // Always exit 0. A fingerprint that could not be computed means the next
        // run re-plans, which is today's behaviour — not a reason to fail the run
        // that just produced a working plan.
      } else if (sub === 'reuse') {
        const name = requireChange(root, requested, json)
        const result = resolvePlanReuse(root, name, {
          maxParallel,
          planPath: typeof flags.plan === 'string' ? flags.plan : undefined,
          fingerprintPath: typeof flags.fingerprint === 'string' ? flags.fingerprint : undefined
        })

        // The narrowed plan is written to its OWN path: overwriting the stored
        // plan with a narrowed copy would make the next run's fingerprint check
        // compare against a plan that no longer covers the tasks it was hashed
        // for.
        let narrowedPath = null
        if (result.reuse && result.narrowed && !result.noRemainingWork) {
          narrowedPath =
            typeof flags.out === 'string' && flags.out.trim() ? flags.out.trim() : NARROWED_PLAN_PATH
          const dest = join(root, narrowedPath)
          try {
            mkdirSync(dirname(dest), { recursive: true })
            writeFileSync(dest, JSON.stringify(result.narrowed, null, 2) + '\n')
          } catch (err) {
            // Cannot stage the narrowed plan → cannot reuse it. Say which, and
            // fall back to the classifier rather than to a plan nobody can read.
            const failed = {
              change: name,
              reuse: false,
              status: 'check-failed',
              reason: `the narrowed plan could not be written to ${narrowedPath}: ${err.message}`,
              narrowedPath: null
            }
            emit(json, failed, formatPlanReuse(failed))
            break
          }
        }

        const payload = {
          change: name,
          reuse: result.reuse,
          status: result.status,
          reason: result.reason,
          noRemainingWork: Boolean(result.noRemainingWork),
          narrowedPath,
          planPath: result.planPath,
          fingerprintPath: result.fingerprintPath,
          waveCount: result.waveCount ?? null,
          laneCount: result.laneCount ?? null,
          taskCount: result.taskCount ?? null,
          droppedTaskIds: result.droppedTaskIds || []
        }
        emit(
          json,
          payload,
          formatPlanReuse(result) +
            (narrowedPath ? `  narrowed plan → ${narrowedPath}\n` : '')
        )
        // Always exit 0, in both directions: not reusing is the normal, correct
        // outcome on a first run, and an error while checking is a reason to
        // re-plan rather than a reason to stop.
      } else {
        die(`unknown plan subcommand: ${sub || '(none)'} — expected fingerprint|reuse`)
      }
      break
    }

    case 'wave-state': {
      const sub = positional[1]
      const change = typeof flags.change === 'string' ? flags.change : undefined
      if (sub === 'create') {
        const plan = readInput(flags.plan, '--plan <file|->')
        const maxParallel = num(flags, 'max-parallel')
        // The one place the name enters the run: from here it travels on the
        // state, and no later wave-state invocation needs the flag.
        const state = createRunState(plan, { maxParallel, change })
        const { ok: logOk } = logWaveMutation(root, { source: 'create', change, state })
        emit(json, state, formatRunState(state))
        if (!logOk) process.exit(1)
      } else if (sub === 'next') {
        const state = readInput(flags.state, '--state <file|->')
        const { step, ok: logOk } = logWaveMutation(root, { source: 'next', change, state })
        const spawnOk = logAgentSpawns(root, { state, change, step, source: 'next' })
        emit(json, step, formatRunState(state))
        if (step.action === 'halt' || !logOk || !spawnOk) process.exit(1)
      } else if (sub === 'record-batch' || sub === 'record-verify') {
        const state = readInput(flags.state, '--state <file|->')
        const result = readInput(flags.result, '--result <file|->')
        // The observed path set is passed as an argument, never read from
        // `result`: `result` is written by the agent being audited, and an audit
        // whose input its subject supplies is not an audit.
        const next =
          sub === 'record-batch'
            ? recordBatchResult(state, result, { changedPaths: observedChangedPaths(root) })
            : recordVerifyResult(state, result)
        const { ok: logOk } = logWaveMutation(root, { source: sub, change, state: next })
        // Derived from the two states rather than returned by the recorder, so
        // `recordBatchResult`'s signature and every other caller are untouched.
        const recorded = sub === 'record-batch' ? batchOutcomes(state, next) : undefined
        emitRecordedState(json, flags, next, { root, change, logOk, source: sub, recorded })
      } else if (sub === 'replan') {
        const state = readInput(flags.state, '--state <file|->')
        const groups = readInput(flags.groups, '--groups <file|->')
        if (!Array.isArray(groups)) {
          die('--groups must be a JSON array of { group, tasks } revisions')
        }
        const next = applyReplan(state, groups)
        const { ok: logOk } = logWaveMutation(root, { source: 'replan', change, state: next })
        emitRecordedState(json, flags, next, { root, change, logOk, source: 'replan' })
      } else {
        die(
          `unknown wave-state subcommand: ${sub || '(none)'} — expected ` +
            'create|next|record-batch|record-verify|replan'
        )
      }
      break
    }

    case 'autonomy': {
      const sub = positional[1]
      const opts = { root: flags.root ? String(flags.root) : undefined }
      if (sub === 'level') {
        const path = positional[2]
        if (!path) die('autonomy level requires a path')
        const level = getLevel(path, opts)
        emit(json, { path, level }, `${level}\n`)
      } else if (sub === 'record') {
        const path = positional[2]
        if (!path) die('autonomy record requires a path')
        const outcome = flags['human-override']
          ? { human_override: true }
          : { blockers: Number(flags.blockers || 0) }
        const result = record(path, outcome, opts)
        const text = result.promoted
          ? `${path}: promoted ${result.from} → ${result.to}\n`
          : `${path}: ${result.current_level} (${result.consecutive_clean}/${result.needed} clean)\n`
        emit(json, { path, ...result }, text)
      } else if (sub === 'clean') {
        const paths = positional.slice(2)
        if (!paths.length) die('autonomy clean requires at least one path')
        const results = recordCleanFlow(paths, opts)
        const text = results
          .map(r =>
            r.promoted
              ? `${r.path}: promoted ${r.from} → ${r.to}`
              : `${r.path}: ${r.current_level} (${r.consecutive_clean}/${r.needed} clean)`
          )
          .join('\n') + '\n'
        emit(json, results, text)
      } else if (sub === 'state') {
        const state = getState(opts)
        const text = Object.entries(state).length
          ? Object.entries(state)
              .map(([p, e]) => `${e.current_level}\t${p}\truns=${e.runs} clean=${e.consecutive_clean} blockers=${e.blockers_caught}`)
              .join('\n') + '\n'
          : '(no recorded runs)\n'
        emit(json, state, text)
      } else {
        die(`unknown autonomy subcommand: ${sub || '(none)'}`)
      }
      break
    }

    default:
      process.stderr.write(`Unknown command: ${cmd}\n\n${USAGE}`)
      process.exit(1)
  }
}

// `judge` and `unit` take the same two evidence inputs, so they read them the
// same way.
function verifyJudgeOpts(flags) {
  const opts = {}
  if (flags.baseline !== undefined) opts.baseline = readInput(flags.baseline, '--baseline <file|->')
  if (flags['pre-existing'] === true) opts.preExistingFailures = true
  if (flags['pre-existing-signatures'] !== undefined) {
    const sigs = readInput(flags['pre-existing-signatures'], '--pre-existing-signatures <file|->')
    if (!Array.isArray(sigs)) die('--pre-existing-signatures must be a JSON array of strings')
    opts.preExistingFailures = sigs
  }
  return opts
}

try {
  main()
} catch (err) {
  if (err && err.userFacing) die(err.message)
  process.stderr.write(`interlock: ${err && err.message ? err.message : err}\n`)
  process.exit(1)
}

{
  "name": "@renzrollon/interlock",
  "version": "1.13.0",
  "description": "Spec-driven development for Claude Code, layered on OpenSpec. You read one spec; parallel agents ship it to a tested commit.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "interlock": "cli/interlock",
    "interlock-graph": "cli/interlock-graph",
    "interlock-run": "cli/interlock-run",
    "interlock-ship-acp": "cli/interlock-ship-acp"
  },
  "files": [
    "cli",
    "lib",
    "workflows",
    "skills",
    "hooks",
    "types",
    "agents",
    "shared",
    ".claude-plugin/plugin.json",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test $(find test -name '*.test.mjs' | sort)",
    "validate": "claude plugin validate . --strict"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renzrollon/interlock.git"
  }
}

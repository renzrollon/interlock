{
  "name": "interlock",
  "displayName": "Interlock",
  "version": "0.2.0",
  "description": "Autonomous spec-driven development orchestration for Claude Code, layered on OpenSpec. Onboard a repo, produce a reviewed spec, then ship it start-to-commit with parallel agents and a deterministic gate spine.",
  "author": {
    "name": "Carl Rollon",
    "url": "https://github.com/renzrollon"
  },
  "homepage": "https://github.com/renzrollon/interlock",
  "repository": "https://github.com/renzrollon/interlock",
  "license": "MIT",
  "keywords": [
    "openspec",
    "spec-driven-development",
    "orchestration",
    "multi-agent",
    "code-review",
    "knowledge-graph"
  ],
  "workflows": "./workflows",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/preflight.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-tests.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-tasks.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-commit.mjs\""
          }
        ]
      }
    ]
  }
}
